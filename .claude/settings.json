{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.py"],
            "statusMessage": "Checking git policy…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Edit(**/.git/**)", "Write(**/.git/**)", "Bash(gh pr merge *)"]
  }
}
